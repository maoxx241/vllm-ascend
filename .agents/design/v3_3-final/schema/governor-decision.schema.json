{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/vllm-ascend/schema/governor-decision.schema.json",
  "title": "GovernorDecision",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "stage",
    "allow_query",
    "resolved_budget_class",
    "resolved_token_cap",
    "max_capsules",
    "max_deep_refs",
    "flush_required",
    "must_compact_after",
    "cache_preferred",
    "warnings",
    "denial_reason_code",
    "dedupe_key"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "governor-decision/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "public_entry",
        "intake",
        "spec_plan",
        "atomic"
      ],
      "description": "Derived effective stage. Must equal selector_plan.query_stage when a decision is produced from a plan. Never caller-authored."
    },
    "allow_query": {
      "type": "boolean"
    },
    "resolved_budget_class": {
      "type": "string",
      "enum": [
        "routing",
        "intake",
        "spec",
        "atomic",
        "burst_spec",
        "burst_atomic"
      ]
    },
    "resolved_token_cap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16000
    },
    "max_capsules": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "max_deep_refs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "flush_required": {
      "type": "boolean"
    },
    "must_compact_after": {
      "type": "boolean"
    },
    "cache_preferred": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denial_reason_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "missing_trigger_code",
        "stage_disallows_query",
        "pending_flush",
        "budget_exceeded",
        "duplicate_plan",
        "unrelated_domain_expansion",
        "missing_persistence_bundle"
      ]
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1
    },
    "compaction_target_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$comment": "Contract rule: evaluate_governor does not accept a caller-authored stage input. The stage in governor-decision is a derived echo of selector_plan.query_stage."
}
