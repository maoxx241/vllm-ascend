{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/vllm-ascend/schema/kb-pack-request.schema.json",
  "title": "KbPackRequest",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "intent",
    "repo_root",
    "resolve_policy",
    "logical_domains",
    "selectors",
    "must_have",
    "nice_to_have",
    "budget_token_cap",
    "max_atoms",
    "max_hops",
    "include_evidence_stubs",
    "stop_after_first_sufficient",
    "emit_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kb-pack-request/v2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "enum": [
        "routing",
        "intake_lookup",
        "deployment_lookup",
        "perf_breakdown",
        "model_expectation",
        "debug_triage",
        "design_lookup",
        "adaptation_codegen",
        "operator_codegen",
        "upstream_delta",
        "validation_selection"
      ]
    },
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "resolve_policy": {
      "type": "string",
      "enum": [
        "auto",
        "strict_existing",
        "rebuild"
      ]
    },
    "logical_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "knowledge_governance",
          "vllm_upstream",
          "vllm_ascend_core",
          "ascend_foundation",
          "integration_core",
          "deployment_config",
          "troubleshooting",
          "validation_evidence"
        ]
      }
    },
    "physical_shard_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selectors": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "hw": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "prs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "configs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "must_have": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nice_to_have": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_token_cap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16000
    },
    "max_atoms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "max_hops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "include_evidence_stubs": {
      "type": "boolean"
    },
    "stop_after_first_sufficient": {
      "type": "boolean"
    },
    "emit_path": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
