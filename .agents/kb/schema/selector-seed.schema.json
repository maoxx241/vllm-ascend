{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/vllm-ascend/schema/selector-seed.schema.json",
  "title": "SelectorSeed",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "objective",
    "requested_artifact",
    "target_object",
    "task_family_candidates",
    "execution_mode_hint",
    "analysis_depth_hint",
    "deliverable_contract_hint",
    "normalized_entities",
    "evidence_inventory",
    "evidence_level",
    "execution_context",
    "code_change_expectation",
    "constraints",
    "unresolved_slots",
    "confirmation_required",
    "confirmation_status",
    "smallest_next_step",
    "what_is_missing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "selector-seed/v3"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "requested_artifact": {
      "type": "string",
      "enum": [
        "reference_answer",
        "deployment_artifact_pack",
        "analysis_report",
        "design_note",
        "spec_plan",
        "code_change_pack"
      ]
    },
    "target_object": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "display_name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "model",
            "feature",
            "operator",
            "deployment",
            "issue",
            "log_bundle",
            "profiling_bundle",
            "code_surface",
            "commit_range",
            "pr",
            "validation_scope",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "task_family_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "deployment_execution",
          "performance_analysis",
          "debugging",
          "design_analysis",
          "adaptation",
          "operator_development",
          "upstream_sync",
          "validation_strategy"
        ]
      }
    },
    "family_confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "execution_mode_hint": {
      "type": "string",
      "enum": [
        "direct_answer",
        "direct_atomic_workflow",
        "spec_plan_workflow"
      ]
    },
    "analysis_depth_hint": {
      "type": "string",
      "enum": [
        "none",
        "lightweight_design_note",
        "full_spec_plan"
      ]
    },
    "deliverable_contract_hint": {
      "type": "string",
      "enum": [
        "reference_answer",
        "deployment_artifact_pack",
        "analysis_report",
        "design_note",
        "spec_plan",
        "code_change_pack"
      ]
    },
    "normalized_entities": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "hw": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "prs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "configs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "evidence_inventory": {
      "type": "object",
      "required": [
        "evidence_kinds",
        "has_runtime_tuple",
        "has_baseline",
        "has_validation_assets"
      ],
      "properties": {
        "evidence_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "user_request_only",
              "logs",
              "profiling",
              "code_or_diff",
              "configs_or_scripts",
              "runtime_tuple",
              "baseline_or_expectation",
              "tests_or_validation_assets"
            ]
          }
        },
        "has_runtime_tuple": {
          "type": "boolean"
        },
        "has_baseline": {
          "type": "boolean"
        },
        "has_validation_assets": {
          "type": "boolean"
        },
        "inline_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "zero_evidence",
        "minimal_intake_ready",
        "analysis_ready",
        "spec_plan_ready"
      ]
    },
    "execution_context": {
      "type": "string",
      "enum": [
        "local_only",
        "user_mediated_remote",
        "direct_remote_access",
        "remote_unavailable"
      ]
    },
    "code_change_expectation": {
      "type": "string",
      "enum": [
        "no_change_expected",
        "code_change_possible",
        "code_change_required",
        "unknown"
      ]
    },
    "constraints": {
      "type": "object",
      "required": [
        "hard_constraints",
        "soft_constraints"
      ],
      "properties": {
        "hard_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "soft_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "unresolved_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmation_required": {
      "type": "boolean"
    },
    "confirmation_status": {
      "type": "string",
      "enum": [
        "not_needed",
        "pending",
        "confirmed",
        "user_declined"
      ]
    },
    "confirmation_reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "code_change_scope",
          "repo_mutation_scope",
          "remote_execution_scope",
          "high_cost_spec_plan",
          "destructive_operation_scope"
        ]
      },
      "default": []
    },
    "smallest_next_step": {
      "type": "string",
      "minLength": 1
    },
    "what_is_missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "confirmation_required": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "confirmation_status": {
            "const": "not_needed"
          },
          "confirmation_reason_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confirmation_required": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "confirmation_reason_codes"
        ],
        "properties": {
          "confirmation_status": {
            "enum": [
              "pending",
              "confirmed",
              "user_declined"
            ]
          },
          "confirmation_reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
