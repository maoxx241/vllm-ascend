{
  "matrix_type": "recommendations",
  "version": "1.0.0",
  "created_at": "2026-03-10T00:00:00Z",
  "description": "推荐配置矩阵，针对不同模型、场景和硬件给出最佳配置建议",
  "model_recommendations": {
    "DeepSeek-V3": {
      "description": "DeepSeek-V3 MoE模型，支持MLA注意力和多种优化",
      "recommended_features": [
        "feature:flashcomm1",
        "feature:eplb",
        "feature:chunked_prefill",
        "feature:async_scheduling"
      ],
      "optional_features": [
        "feature:dynamic_eplb",
        "feature:speculative_decoding",
        "feature:context_parallel"
      ],
      "incompatible_features": [],
      "config_templates": {
        "standard": {
          "description": "标准配置，适用于大多数场景",
          "env_vars": {
            "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
          },
          "additional_config": {
            "eplb_config": {
              "num_redundant_experts": 0,
              "eplb_policy_type": 1
            }
          },
          "command_args": [
            "--enable-chunked-prefill",
            "--async-scheduling"
          ]
        },
        "high_throughput": {
          "description": "高吞吐配置，适用于批量推理",
          "env_vars": {
            "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
          },
          "additional_config": {
            "eplb_config": {
              "num_redundant_experts": 2,
              "eplb_policy_type": 1
            }
          },
          "command_args": [
            "--enable-chunked-prefill",
            "--async-scheduling",
            "--max-num-batched-tokens 8192"
          ]
        },
        "speculative": {
          "description": "推测解码配置，适用于低延迟场景",
          "env_vars": {
            "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
          },
          "speculative_config": {
            "method": "mtp",
            "num_speculative_tokens": 4
          },
          "command_args": [
            "--enable-chunked-prefill",
            "--async-scheduling"
          ]
        }
      }
    },
    "DeepSeek-V3.2": {
      "description": "DeepSeek V3.2 DSA模型，支持SFA和DSA-CP优化",
      "recommended_features": [
        "feature:flashcomm1",
        "feature:dsa_cp",
        "feature:layer_sharding",
        "feature:mlapo"
      ],
      "optional_features": [
        "feature:flashcomm2",
        "feature:weight_prefetch"
      ],
      "incompatible_features": [],
      "config_templates": {
        "p_node": {
          "description": "Prefill节点配置",
          "env_vars": {
            "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
          },
          "additional_config": {
            "layer_sharding": ["q_b_proj", "o_proj"],
            "weight_prefetch_config": {
              "enabled": true
            }
          },
          "notes": "P节点启用Layer Sharding，权重广播与计算重叠"
        },
        "d_node": {
          "description": "Decode节点配置",
          "env_vars": {
            "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
          },
          "additional_config": {
            "weight_prefetch_config": {
              "enabled": true
            }
          },
          "notes": "D节点不启用Layer Sharding"
        }
      }
    },
    "DeepSeek-R1": {
      "description": "DeepSeek-R1推理模型，支持长序列和Context Parallel",
      "recommended_features": [
        "feature:flashcomm1",
        "feature:context_parallel",
        "feature:chunked_prefill"
      ],
      "optional_features": [
        "feature:speculative_decoding"
      ],
      "incompatible_features": [],
      "config_templates": {
        "long_sequence": {
          "description": "长序列配置，适用于128k+输入",
          "env_vars": {
            "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
          },
          "command_args": [
            "--prefill-context-parallel-size 2",
            "--enable-chunked-prefill",
            "--max-model-len 131072"
          ],
          "notes": "PCP将128k输入TTFT从73.2s降至46.0s"
        }
      }
    },
    "Qwen3": {
