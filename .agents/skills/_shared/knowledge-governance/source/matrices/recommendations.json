  "scenario_recommendations": {
    "high_throughput": {
      "description": "高吞吐场景，最大化请求处理能力",
      "priority": "吞吐量优先",
      "recommended_features": [
        "feature:chunked_prefill",
        "feature:async_scheduling",
        "feature:flashcomm1",
        "feature:eplb"
      ],
      "config_guidelines": [
        "增大max_num_batched_tokens",
        "启用冗余专家(num_redundant_experts > 0)",
        "使用量化减少显存占用",
        "启用动态EPLB适应负载变化"
      ],
      "example_config": {
        "env_vars": {
          "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
        },
        "additional_config": {
          "eplb_config": {
            "num_redundant_experts": 2,
            "dynamic_eplb": true
          }
        },
        "command_args": [
          "--enable-chunked-prefill",
          "--async-scheduling",
          "--max-num-batched-tokens 8192"
        ]
      }
    },
    "low_latency": {
      "description": "低延迟场景，最小化首token时间",
      "priority": "延迟优先",
      "recommended_features": [
        "feature:speculative_decoding",
        "feature:async_scheduling",
        "feature:weight_prefetch",
        "feature:xlite_graph"
      ],
      "config_guidelines": [
        "使用EAGLE/MTP推测解码",
        "启用权重预取",
        "使用XliteGraph优化Decode",
        "减小batch size以降低排队延迟"
      ],
      "example_config": {
        "speculative_config": {
          "method": "eagle",
          "num_speculative_tokens": 4
        },
        "additional_config": {
          "weight_prefetch_config": {
            "enabled": true
          },
          "xlite_graph_config": {
            "enabled": true,
            "full_mode": false
          }
        },
        "command_args": [
          "--async-scheduling",
          "--block-size 128"
        ]
      }
    },
    "long_sequence": {
      "description": "长序列场景，处理超长输入",
      "priority": "内存和长序列优化",
      "recommended_features": [
        "feature:context_parallel",
        "feature:chunked_prefill",
        "feature:flashcomm1"
      ],
      "config_guidelines": [
        "启用PCP加速长序列Prefill",
        "启用DCP减少KV Cache冗余",
        "增大max_model_len",
        "设置合适的long_prefill_token_threshold"
      ],
      "example_config": {
        "env_vars": {
          "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
        },
        "command_args": [
          "--prefill-context-parallel-size 2",
          "--decode-context-parallel-size 2",
          "--enable-chunked-prefill",
          "--max-model-len 131072",
          "--long-prefill-token-threshold 16384"
        ]
      }
    },
    "memory_constrained": {
      "description": "显存受限场景",
      "priority": "内存优化",
      "recommended_features": [
        "feature:quantization",
        "feature:layer_sharding",
        "feature:context_parallel"
      ],
      "config_guidelines": [
        "使用AWQ/GPTQ 4-bit量化",
        "启用KV Cache量化(--kv-cache-dtype fp8)",
        "启用DCP减少KV Cache冗余",
        "减小max_num_seqs"
      ],
      "example_config": {
        "command_args": [
          "--quantization awq",
          "--kv-cache-dtype fp8",
          "--decode-context-parallel-size 2",
          "--max-num-seqs 128"
        ]
      }
    },
    "pd_disaggregation": {
      "description": "PD分离部署场景",
      "priority": "资源独立扩展",
      "recommended_features": [
        "feature:pd_disaggregation",
        "feature:layer_sharding",
        "feature:flashcomm1"
      ],
      "config_guidelines": [
        "P节点使用更大TP加速Prefill",
        "D节点使用较小TP节省资源",
        "P节点启用Layer Sharding",
        "使用高速网络(RoCE)"
      ],
      "example_config": {
        "p_node": {
          "env_vars": {
            "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1",
            "VLLM_ASCEND_FLASHCOMM2_PARALLEL_SIZE": "1"
          },
          "additional_config": {
            "layer_sharding": ["o_proj"],
            "kv_transfer_config": {
              "role": "kv_producer"
            }
          }
        },
        "d_node": {
          "env_vars": {
            "VLLM_ASCEND_ENABLE_FLASHCOMM1": "1"
          },
          "additional_config": {
            "kv_transfer_config": {
              "role": "kv_consumer"
            }
          }
        }
      }
    }
  },
