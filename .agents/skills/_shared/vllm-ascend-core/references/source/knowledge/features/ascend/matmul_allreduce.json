    "design": {
      "principle": "将Matmul计算结果直接进行ReduceScatter，然后分块计算RMSNorm，最后AllGather恢复完整tensor。避免完整tensor的AllReduce，减少通信数据量。",
      "theory_analysis": "传统AllReduce需要传输完整tensor。融合后：1) ReduceScatter传输1/TP_size的数据；2) 本地计算RMSNorm；3) AllGather恢复。通信量减少，且计算与通信重叠。",
      "design_decisions": [
        {
          "decision": "阈值512：低于此batch size融合收益不明显",
          "reason": ""
        },
        {
          "decision": "区分MiddleLayer和LastLayer：输出处理不同",
          "reason": ""
        },
        {
          "decision": "仅支持A2芯片：其他芯片通信优化方式不同",
          "reason": ""
        }
      ]
    }
