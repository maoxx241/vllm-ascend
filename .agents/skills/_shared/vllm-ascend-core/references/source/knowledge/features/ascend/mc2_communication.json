    "design": {
      "principle": "根据硬件特性、并行配置和数据特征自动选择最优通信方式，实现通信与计算的最大重叠",
      "theory_analysis": "MoE模型的通信模式直接影响性能：ALLGATHER通信量最大但实现简单；MC2通过通信计算重叠减少延迟；ALLTOALL适合DP场景；FUSED_MC2通过算子融合进一步优化。选择逻辑基于：1)设备类型决定可用算子；2)EP配置决定是否需要跨rank通信；3)token数量决定通信开销占比；4)量化类型决定是否支持融合算子。",
      "design_decisions": [
        {
          "decision": "A2设备：token<=capacity且DP>=16时选MC2，否则ALLGATHER",
          "reason": "A2设备MC2算子性能优异，但需要足够的DP规模才能发挥优势。DP>=16时通信带宽利用率高，MC2收益明显。"
        },
        {
          "decision": "A3设备：优先FUSED_MC2，其次MC2，最后ALLTOALL",
          "reason": "A3设备支持dispatch_ffn_combine和dispatch_gmm_combine_decode融合算子，性能最优。但需要w8a8_dynamic量化和EP<=32。"
        },
        {
          "decision": "A5设备：DP>1且token<=capacity时选MC2，否则ALLTOALL",
          "reason": "A5设备MC2算子性能优异，但需要DP配置才能启用。无DP时回退到ALLTOALL。"
        },
        {
          "decision": "310P设备：仅支持ALLGATHER",
          "reason": "310P设备不支持MC2相关算子，只能使用ALLGATHER。"
        },
        {
          "decision": "mc2_tokens_capacity限制MC2使用",
          "reason": "MC2算子有预分配内存容量限制，超过容量时需要回退到ALLGATHER或ALLTOALL，避免内存溢出。"
        }
      ],
      "communication_types": [
        {
          "type": "ALLGATHER",
          "description": "每个rank持有完整expert副本，通信量最大，实现最简单，兼容性最好",
          "suitable_for": [
            "EP=1",
            "310P设备",
            "小token场景"
          ]
        },
        {
          "type": "MC2",
          "description": "通信计算重叠，使用npu_moe_distribute_dispatch/combine，延迟低",
          "suitable_for": [
            "A2设备(DP>=16)",
            "A3设备",
            "A5设备(DP>1)",
            "大token场景"
          ]
        },
        {
          "type": "ALLTOALL",
          "description": "使用all-to-all通信交换token，适合DP场景",
          "suitable_for": [
            "A3设备(大token)",
            "A5设备(无DP)",
            "DP场景"
          ]
        },
        {
          "type": "FUSED_MC2",
          "description": "融合dispatch+compute+combine，性能最优",
          "suitable_for": [
            "A3设备",
            "w8a8_dynamic量化",
            "EP<=32",
            "非MTP模式"
          ]
        }
      ]
    }
  },
